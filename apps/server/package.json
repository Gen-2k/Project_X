    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@project/database": "workspace:*",
    "@project/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
