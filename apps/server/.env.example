# Application Configuration
NODE_ENV="development"
PORT="3000"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Database Configuration
# In production, replace with your actual database URL
DATABASE_URL="postgresql://user:password@localhost:5432/project_x?schema=public"

# Authentication Configuration
# MUST be changed in production (at least 32 characters, enforced by env validation)
JWT_SECRET="change-me-to-a-random-secret-of-32-characters"
JWT_EXPIRES_IN="1d"

# Cookie Configuration
# Set to "true" only when serving over HTTPS; keep "false" for plain-HTTP
# deployments (e.g. the dockerized setup), otherwise browsers drop the cookie.
COOKIE_SECURE="false"
