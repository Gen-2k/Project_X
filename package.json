{
  "name": "project_x_monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "analyze": "knip",
    "build": "turbo run build",
    "changeset": "changeset",
    "db:generate": "turbo run db:generate",
    "dev": "turbo run dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@project/eslint-config": "workspace:*",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.4.2",
    "turbo": "^2.10.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
