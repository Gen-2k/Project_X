# Normalize line endings to LF for all text files
# Prevents CRLF/LF conflicts on Windows and keeps Prettier's endOfLine: "lf" check green
* text=auto eol=lf

# Binary files must not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.pdf binary

# Lock files are machine-generated and diff as-is
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff