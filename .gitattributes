# Normalize line endings to LF for all text files
# Prevents CRLF/LF conflicts on Windows and keeps Prettier's endOfLine: "lf" check green
* text=auto eol=lf

# Binary files must not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
